# -----------------------------------------------------------------------
# .env.example
#
# Copy this file to ".env" and fill in real values for LOCAL DEVELOPMENT.
# NEVER commit the real ".env" file to Git (it is already listed in
# .gitignore).
#
# In production (Render), do NOT upload a .env file at all — instead,
# set these same variable names in Render's dashboard under:
#   Your Service -> Environment -> Environment Variables
# -----------------------------------------------------------------------

# Which LLM provider to use. Currently supported: "gemini"
LLM_PROVIDER=gemini

# Your Gemini API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSyBBOWy9R_DCy-37PQLP4DBLc7aaBAdhdmQ"

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# App environment: "development" or "production"
APP_ENV=development

# Comma-separated list of origins allowed to call this API from a browser.
# Include your local frontend AND your deployed Vercel domain.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app
